---
// Portal Loops controls, slotted into the lab ControlPanel's slide-out.
// Talks to PortalsLoops.js through window events:
//   dispatch 'portals:file'        → { detail: { file } }  play a local track
//   dispatch 'portals:auto-toggle'                         auto look on/off (hold)
//   dispatch 'portals:next-look'                           new random look now
//   listen   'portals:auto'        → { detail: { on } }
---

<div class="portals-loops-controls">
  <label class="portals-loops-controls__btn" data-tip="Play your own track">
    <input type="file" accept="audio/*" data-loops-file hidden />
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"></path>
    </svg>
    <span class="visually-hidden">Play your own track</span>
  </label>
  <button
    type="button"
    class="portals-loops-controls__btn"
    data-loops-auto
    aria-pressed="false"
    data-tip="Auto-change look every 8 bars"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M10.59 9.17 5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"
      ></path>
    </svg>
    <span class="visually-hidden">Auto-change look</span>
  </button>
  <button type="button" class="portals-loops-controls__btn" data-loops-next data-tip="New look">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
      ></path>
    </svg>
    <span class="visually-hidden">New look</span>
  </button>
</div>

<style lang="scss">
  .portals-loops-controls {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .portals-loops-controls__btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--lab-white);
    cursor: pointer;

    svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
    }

    &:hover,
    &[aria-pressed='true'] {
      color: var(--lab-pink);
    }

    &:focus-visible,
    &:focus-within {
      outline: 2px solid var(--rs-color-focus-ring);
      outline-offset: 2px;
      border-radius: 4px;
    }

    // Small tooltip above the button on hover/focus.
    &::after {
      content: attr(data-tip);
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%);
      padding: 4px 8px;
      white-space: nowrap;
      font-size: 12px;
      color: var(--lab-white);
      background: var(--lab-header-bg);
      border: 1px solid var(--lab-header-border);
      opacity: 0;
      pointer-events: none;
      transition: opacity 150ms ease;
    }

    &:hover::after,
    &:focus-visible::after {
      opacity: 1;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  const file = document.querySelector<HTMLInputElement>('[data-loops-file]');
  const auto = document.querySelector<HTMLButtonElement>('[data-loops-auto]');
  const next = document.querySelector<HTMLButtonElement>('[data-loops-next]');

  file?.addEventListener('change', () => {
    const picked = file.files?.[0];
    if (picked) window.dispatchEvent(new CustomEvent('portals:file', { detail: { file: picked } }));
    file.value = '';
  });
  auto?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('portals:auto-toggle')));
  next?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('portals:next-look')));

  window.addEventListener('portals:auto', (event) => {
    const on = Boolean((event as CustomEvent<{ on?: boolean }>).detail?.on);
    auto?.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
</script>
