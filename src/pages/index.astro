---
import BaseLayout from '@labcat2020/animation-lab/layouts/BaseLayout.astro';
import SiteHeader from '@labcat2020/animation-lab/components/SiteHeader.astro';
import SeriesHome from '@labcat2020/animation-lab/components/SeriesHome.astro';
import { getAllSketches } from '@/sketchMetadata.js';

const sketches = getAllSketches();
const tagline = 'Step through the ring-gate. Audio-reactive portal animations.';
---

<BaseLayout title="Portals | LABCAT Animations" description="Portals: audio-reactive portal animations by LABCAT. Step through the ring-gate, or upload your own track.">
  <SiteHeader slot="header" collapsible={false} />
  <SeriesHome name="Portals" tagline={tagline} sketches={sketches} planet="portals" accentA="#0cdbf5" accentB="#ff0cb8" />
</BaseLayout>
